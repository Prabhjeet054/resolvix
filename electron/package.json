{
  "name": "resolvix-desktop",
  "version": "0.1.0",
  "description": "Resolvix desktop shell — Electron launcher for the shared FastAPI UI (Agent Resolve, Emerging Incidents, feedback, hybrid search).",
  "main": "main.js",
  "author": "Resolvix",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "pack": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --dir -c.mac.identity=null",
    "dist": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder -c.mac.identity=null",
    "dist:mac": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac -c.mac.identity=null",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux"
  },
  "build": {
    "appId": "com.resolvix.desktop",
    "productName": "Resolvix",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "scripts/**/*",
      "splash.html",
      "package.json"
    ],
    "extraMetadata": {
      "main": "main.js"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "identity": null,
      "target": ["zip", "dmg"]
    },
    "win": {
      "target": ["nsis", "portable"]
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Office"
    }
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  }
}
